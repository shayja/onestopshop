---
import Base from "../layouts/Base.astro";
import ArticleCta from "../components/ArticleCta.astro";
import { categories, allGuides } from "../data/guides";

const ld0 = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "מדריכים לבעלי עסקים",
  url: "https://onestopshop.co.il/guides/",
  inLanguage: "he",
  author: {
    "@type": "Organization",
    name: "One Stop Shop",
    url: "https://onestopshop.co.il/",
  },
  publisher: {
    "@type": "Organization",
    name: "One Stop Shop",
    logo: {
      "@type": "ImageObject",
      url: "https://onestopshop.co.il/favicon-512.png",
    },
  },
  mainEntity: {
    "@type": "ItemList",
    itemListElement: allGuides.map((g, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: g.name,
      url: `https://onestopshop.co.il${g.href}`,
    })),
  },
});
---

<Base
  title={"מדריכים לבעלי עסקים | One Stop Shop"}
  description={"מדריכים מעשיים לבעלי עסקים קטנים: בניית אתר, אפליקציה, אוטומציה ו-AI, סליקה ואינטגרציות, אבטחה, נגישות, אחסון ותחזוקה - בלי ז'רגון ובלי מכירות."}
  path="/guides/"
  ogType="website"
  ogTitle={"מדריכים לבעלי עסקים"}
  ogDescription={"מדריכים מעשיים על אתרים, אפליקציות ואוטומציה לעסקים קטנים - בלי ז'רגון ובלי מכירות."}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={ld0} />
  </Fragment>
    <main class="article" id="main-content">
      <div class="container">
        <h1>מדריכים לבעלי עסקים</h1>

        <p>
          כל מה שלמדנו מפרויקטים אמיתיים - בלי ז'רגון ובלי מכירות. המדריכים כאן
          נכתבו כדי לעזור לכם לקבל החלטות נכונות על הנוכחות הדיגיטלית של העסק:
          מהאתר הראשון ועד חנות, אפליקציה או מערכת - כולל אוטומציה ו-AI, סליקה
          וחיבורים בין מערכות, אבטחה, נגישות, אחסון ותחזוקה שוטפת. לכל שאלה,
          תשובה ישרה: מה כדאי, כמה זה עולה, ומתי עדיף לוותר.
        </p>

        <ul class="chip-row" aria-label="קטגוריות">
          {
            categories.map((c) => (
              <li>
                <a class="chip" href={`#${c.id}`}>
                  {c.label}
                  <span class="chip-count">
                    <span class="visually-hidden">, </span>{c.guides.length}
                    <span class="visually-hidden"> מדריכים</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>

        {
          categories.map((c) => (
            <section class="guide-group" id={c.id} aria-labelledby={`${c.id}-title`}>
              <h2 id={`${c.id}-title`}>{c.label}</h2>
              <ul class="guides-list">
                {c.guides.map((g) => (
                  <li>
                    <a href={g.href}>
                      <h3>{g.title}</h3>
                      <p>{g.desc}</p>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
    </main>

    <ArticleCta title="יש שאלה שלא מצאתם עליה תשובה?" />
</Base>
