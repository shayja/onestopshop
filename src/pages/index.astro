---
import { getImage, Picture } from "astro:assets";
import Base from "../layouts/Base.astro";
import hero1 from "../assets/images/hero-1.webp";
import hero2 from "../assets/images/hero-2.webp";
import hero3 from "../assets/images/hero-3.webp";
import automationPhoto from "../assets/images/automation-photo.webp";
import includedPhoto from "../assets/images/included-photo.webp";
import ctaPhoto from "../assets/images/cta-photo.webp";
import projectDj from "../assets/images/project-dj.jpg";
import projectMusician from "../assets/images/project-musician.webp";
import projectApp from "../assets/images/project-app.webp";
import projectKitchen from "../assets/images/project-kitchen.webp";

// The hero and band photos are CSS backgrounds, so they can't go through
// <Picture>; generate a desktop and a mobile rendition for each here and
// inject the hashed URLs via the style/script tags in the head below.
// 700px is the same breakpoint the old hand-made -m variants used.
const rendition = (src: ImageMetadata, width: number, quality: number) =>
  getImage({ src, format: "webp", width, quality });

const heroDesktop = await Promise.all(
  [hero1, hero2, hero3].map((h) => rendition(h, 1600, 75)),
);
const heroMobile = await Promise.all(
  [hero1, hero2, hero3].map((h) => rendition(h, 900, 75)),
);

// The bands render under a heavy ivory wash (--band-wash 0.82-0.9), so a
// lower encode quality is invisible there and saves real bytes.
const bands = await Promise.all(
  [
    { selector: ".automation", src: automationPhoto },
    { selector: ".included", src: includedPhoto },
    { selector: ".final-cta", src: ctaPhoto },
  ].map(async ({ selector, src }) => ({
    selector,
    desktop: (await rendition(src, 1600, 65)).src,
    mobile: (await rendition(src, 900, 65)).src,
  })),
);

// hero-1 is the no-JS fallback (the inline script overrides --hero-img).
const bgCss = [
  `.hero-photo{background-image:var(--hero-img,url("${heroDesktop[0].src}"))}`,
  ...bands.map((b) => `${b.selector}{--band-img:url("${b.desktop}")}`),
  `@media (max-width:700px){`,
  `.hero-photo{background-image:var(--hero-img,url("${heroMobile[0].src}"))}`,
  ...bands.map((b) => `${b.selector}{--band-img:url("${b.mobile}")}`),
  `}`,
].join("");

const ld0 = String.raw`{
        "@context": "https://schema.org",
        "@type": "ProfessionalService",
        "name": "One Stop Shop",
        "url": "https://onestopshop.co.il/",
        "sameAs": ["https://www.facebook.com/onestopshop.co.il"],
        "logo": "https://onestopshop.co.il/favicon-512.png",
        "image": "https://onestopshop.co.il/images/og-image.jpg",
        "description": "בניית אתרים, אפליקציות ואוטומציה לעסקים קטנים, הכול במקום אחד. מאפיון ועד השקה.",
        "areaServed": {
          "@type": "Country",
          "name": "Israel"
        },
        "inLanguage": "he",
        "knowsAbout": [
          "בניית אתרים",
          "פיתוח אפליקציות",
          "אוטומציה עסקית",
          "סוכני AI"
        ]
      }`;
---

<Base
  title={"One Stop Shop - בניית אתרים, אפליקציות ואוטומציה לעסקים"}
  description={"One Stop Shop - בניית אתרים, אפליקציות ואוטומציה לעסקים קטנים, הכול במקום אחד. מאפיון ועד השקה, כל הפרויקטים חיים באוויר."}
  path="/"
  ogType="website"
  ogTitle={"One Stop Shop - בניית אתרים, אפליקציות ואוטומציה לעסקים"}
  ogDescription={"בניית אתרים, אפליקציות ואוטומציה לעסקים - הכול במקום אחד, מאפיון ועד השקה."}
  variant="home"
  waFloat={true}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={ld0} />
  </Fragment>
  <Fragment slot="head-late">
    <style is:inline set:html={bgCss}></style>
    <script
      is:inline
      define:vars={{
        heroDesktop: heroDesktop.map((h) => h.src),
        heroMobile: heroMobile.map((h) => h.src),
      }}
    >
      (function () {
        var n = Math.floor(Math.random() * 3);
        var mobile = window.matchMedia("(max-width: 700px)").matches;
        var href = (mobile ? heroMobile : heroDesktop)[n];
        document.documentElement.style.setProperty(
          "--hero-img",
          'url("' + href + '")',
        );
        var l = document.createElement("link");
        l.rel = "preload";
        l.as = "image";
        l.href = href;
        l.setAttribute("fetchpriority", "high");
        document.head.appendChild(l);
      })();
    </script>
  </Fragment>
    <header class="hero" id="hero">
      <div class="hero-art" aria-hidden="true">
        <div class="hero-photo"></div>
        <div class="hero-overlay"></div>
      </div>
      <div class="container">
        <p class="hero-brand" dir="ltr">
          One Stop Shop<span class="accent-dot" aria-hidden="true">.</span>
        </p>
        <h1>אתרים, אפליקציות ואוטומציה לעסק שלכם - הכול במקום אחד</h1>
        <p class="hero-value">
          משלב הרעיון ועד העלייה לאוויר: אפיון, עיצוב, פיתוח וחיבור למערכות של
          העסק.
        </p>
        <div class="cta-row hero-ctas">
          <a class="btn btn-whatsapp wa-link" href="#">
            <svg class="icon-wa" aria-hidden="true" focusable="false">
              <use href="#icon-whatsapp" />
            </svg>
            דברו איתנו בוואטסאפ
          </a>
          <a class="btn btn-ghost" href="/website-packages/"
            >חבילות ומחירים <span aria-hidden="true">&#8592;</span></a
          >
        </div>
        <ul class="hero-trust">
          <li>מחיר ולוח זמנים סגורים מראש</li>
          <li>האתר והחשבונות בבעלותכם</li>
          <li>חודש ליווי אחרי ההשקה</li>
        </ul>
      </div>
    </header>

    <main id="main-content">
      <section class="how" aria-label="איך זה עובד">
        <div class="container">
          <ol class="how-strip">
            <li>שיחת אפיון קצרה</li>
            <li>הצעת מחיר סגורה לפרויקט</li>
            <li>אתר באוויר תוך 2-3 שבועות</li>
          </ol>
        </div>
      </section>

      <section class="projects" id="projects" aria-labelledby="projects-title">
        <div class="container">
          <h2 class="section-title ruled" id="projects-title">פרויקטים אחרונים</h2>

          <article class="project reveal">
            <a
              class="frame frame-browser"
              href="https://line808.com/"
              target="_blank"
              rel="noopener"
              tabindex="-1"
              aria-hidden="true"
            >
              <div class="frame-bar">
                <span class="fd"></span><span class="fd"></span
                ><span class="fd"></span
                ><span class="frame-url">line808.com</span>
              </div>
              <Picture
                src={projectDj}
                formats={["avif"]}
                fallbackFormat="webp"
                widths={[480, 760, 976, 1440]}
                sizes="(max-width: 1024px) calc(100vw - 3rem), 976px"
                alt="צילום מסך של אתר line808 - עמוד הבית של DJ Line808"
                loading="lazy"
              />
            </a>
            <p class="proj-num" aria-hidden="true">01</p>
            <h3>אתר תדמית ל־DJ Line808</h3>
            <ul class="tags" aria-label="סוג הפרויקט">
              <li>אתר תדמית</li>
              <li>יומן הופעות</li>
              <li>מערכת פניות</li>
            </ul>
            <p>
              ל־Line808 לא הייתה נוכחות דיגיטלית והופעות נסגרו רק דרך טלפון
              והמלצות. בנינו אתר תדמית עם יומן הופעות, נגן סטים ומערכת פניות -
              היום לקוחות סוגרים דרך האתר.
            </p>
            <a
              class="btn btn-link"
              target="_blank"
              rel="noopener"
              href="https://line808.com/"
              >קישור לאתר <span aria-hidden="true">&#8592;</span></a
            >
          </article>

          <article class="project reveal">
            <a
              class="frame frame-browser"
              href="https://emilyjacoby.me/he"
              target="_blank"
              rel="noopener"
              tabindex="-1"
              aria-hidden="true"
            >
              <div class="frame-bar">
                <span class="fd"></span><span class="fd"></span
                ><span class="fd"></span
                ><span class="frame-url">emilyjacoby.me</span>
              </div>
              <Picture
                src={projectMusician}
                formats={["avif"]}
                fallbackFormat="webp"
                widths={[480, 760, 976, 1440]}
                sizes="(max-width: 1024px) calc(100vw - 3rem), 976px"
                alt="צילום מסך של אתר הפסנתרנית אמילי יעקובי"
                loading="lazy"
              />
            </a>
            <p class="proj-num" aria-hidden="true">02</p>
            <h3>אתר לפסנתרנית אמילי יעקובי</h3>
            <ul class="tags" aria-label="סוג הפרויקט">
              <li>אתר אמן</li>
              <li>נגן מדיה</li>
              <li>יצירת קשר</li>
            </ul>
            <p>
              אמילי הייתה צריכה מקום אחד שמרכז מוזיקה, הופעות ויצירת קשר לקהל
              ולמפיקים. בנינו אתר אמן מהיר שמציג קטעי נגינה מרסיטלים ואפשרויות
              שונות לשת״פ (ליווי סולנים/יות, הזמנה לרסיטלים, שיעורי נגינה).
            </p>
            <a
              class="btn btn-link"
              target="_blank"
              rel="noopener"
              href="https://emilyjacoby.me/he"
              >קישור לאתר <span aria-hidden="true">&#8592;</span></a
            >
          </article>

          <article class="project reveal">
            <a
              class="frame frame-phone"
              href="https://apps.apple.com/il/app/sored/id6774323194"
              target="_blank"
              rel="noopener"
              tabindex="-1"
              aria-hidden="true"
            >
              <Picture
                src={projectApp}
                formats={["avif"]}
                fallbackFormat="webp"
                widths={[240, 480, 780]}
                sizes="(max-width: 375px) 64vw, 240px"
                alt="צילום מסך של אפליקציית שורד - ספירה לאחור"
                loading="lazy"
              />
            </a>
            <p class="proj-num" aria-hidden="true">03</p>
            <h3>שורד/Sored - אפליקציית מובייל</h3>
            <ul class="tags" aria-label="סוג הפרויקט">
              <li>אפליקציית iOS</li>
              <li>App Store</li>
            </ul>
            <p>
              אפליקציה לתלמידים, סטודנטים וחיילים שמציגה כמה זמן נשאר לסיום שנת
              הלימודים/סמסטר/תאריך השחרור, מתי יום ההולדת, החופשה הבאה וכד׳.
            </p>
            <a
              class="btn btn-link"
              target="_blank"
              rel="noopener"
              href="https://apps.apple.com/il/app/sored/id6774323194"
              >קישור ל־App Store <span aria-hidden="true">&#8592;</span></a
            >
          </article>

          <article class="project reveal">
            <a
              class="frame frame-browser"
              href="http://warendorf.co.il"
              target="_blank"
              rel="noopener"
              tabindex="-1"
              aria-hidden="true"
            >
              <div class="frame-bar">
                <span class="fd"></span><span class="fd"></span
                ><span class="fd"></span
                ><span class="frame-url">warendorf.co.il</span>
              </div>
              <Picture
                src={projectKitchen}
                formats={["avif"]}
                fallbackFormat="webp"
                widths={[480, 760, 976, 1440]}
                sizes="(max-width: 1024px) calc(100vw - 3rem), 976px"
                alt="צילום מסך של אתר ורנדורף ישראל - מטבחי יוקרה מגרמניה"
                loading="lazy"
              />
            </a>
            <p class="proj-num" aria-hidden="true">04</p>
            <h3>ורנדורף ישראל - מטבחי יוקרה מגרמניה</h3>
            <ul class="tags" aria-label="סוג הפרויקט">
              <li>אתר תדמית</li>
              <li>מותג יוקרה</li>
              <li>קולקציות</li>
            </ul>
            <p>
              אתר היבואן הישראלי של מטבחי היוקרה הגרמניים וורנדורף. האתר מציג את
              הקולקציות, אולם התצוגה ופרטי יצירת קשר - חלון ראווה דיגיטלי למותג
              יוקרה.
            </p>
            <a
              class="btn btn-link"
              target="_blank"
              rel="noopener"
              href="http://warendorf.co.il"
              >קישור לאתר <span aria-hidden="true">&#8592;</span></a
            >
          </article>
        </div>
      </section>

      <section
        class="automation reveal"
        id="automation"
        aria-labelledby="automation-title"
      >
        <div class="container">
          <div class="section-header">
            <h2 class="section-title" id="automation-title">
              אוטומציה עסקית וסוכני AI שחוסכים לכם עשרות שעות
            </h2>
            <p class="section-intro">
              אנחנו לא רק בונים חלון ראווה - אנחנו מחברים את האתר שלכם למערכות
              התפעוליות של העסק.
            </p>
          </div>

          <div class="flows-grid">
            <div class="flow-card">
              <span class="flow-icon" aria-hidden="true"
                ><svg class="icon" viewBox="0 0 24 24" focusable="false"
                  ><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8Z" /></svg
                ></span
              >
              <h3>תגובה מיידית ללידים</h3>
              <ol class="flow-steps">
                <li class="step">טופס / וואטסאפ נכנס</li>
                <li class="step highlight">מענה AI מותאם אישית</li>
                <li class="step">עדכון אוטומטי ב-CRM והתראה</li>
              </ol>
            </div>

            <div class="flow-card">
              <span class="flow-icon" aria-hidden="true"
                ><svg class="icon" viewBox="0 0 24 24" focusable="false"
                  ><rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18" /></svg
                ></span
              >
              <h3>תיאום פגישות אוטומטי</h3>
              <ol class="flow-steps">
                <li class="step">בקשה לקביעת שיחה</li>
                <li class="step highlight">פתיחת יומן בזמן אמת</li>
                <li class="step">סנכרון מלא + תזכורת בוואטסאפ</li>
              </ol>
            </div>

            <div class="flow-card">
              <span class="flow-icon" aria-hidden="true"
                ><svg class="icon" viewBox="0 0 24 24" focusable="false"
                  ><path d="M12.59 2.59A2 2 0 0 0 11.17 2H4a2 2 0 0 0-2 2v7.17a2 2 0 0 0 .59 1.42l8.7 8.7a2.43 2.43 0 0 0 3.42 0l6.58-6.58a2.43 2.43 0 0 0 0-3.42Z" /><circle cx="7.5" cy="7.5" r="1" /></svg
                ></span
              >
              <h3>הצעת מחיר בלייב</h3>
              <ol class="flow-steps">
                <li class="step">העלאת תמונה / תיאור צורך</li>
                <li class="step highlight">ניתוח אלגוריתמי מבוסס AI</li>
                <li class="step">פלט מיידי של הצעת מחיר</li>
              </ol>
            </div>
          </div>
          <a class="btn btn-link section-more" href="/automation-guide/"
            >למדריך האוטומציה המלא <span aria-hidden="true">&#8592;</span></a
          >
        </div>
      </section>

      <section class="pricing reveal" id="pricing" aria-labelledby="pricing-title">
        <div class="container">
          <h2 class="section-title ruled" id="pricing-title">חבילות ומחירים</h2>
          <p class="section-intro">
            תכולה כתובה, מחיר סגור ולוח זמנים ברור - לפני שמתחילים.
          </p>
          <ul class="price-grid">
            <li>
              <a href="/website-packages/#pkg-landing">
                <h3>דף נחיתה ממוקד</h3>
                <p class="price"><strong>1,000 ₪</strong> <span class="vat">+ מע״מ</span></p>
                <p>עמוד אחד · מסירה בתוך 5 ימים</p>
              </a>
            </li>
            <li>
              <a href="/website-packages/#pkg-brochure">
                <h3>אתר תדמית ממוקד</h3>
                <p class="price"><strong>5,000 ₪</strong> <span class="vat">+ מע״מ</span></p>
                <p>עד 5 עמודים · מסירה בתוך שבועיים</p>
              </a>
            </li>
            <li class="featured">
              <a href="/website-packages/#pkg-business">
                <span class="package-badge">מומלץ</span>
                <h3>אתר עסקי ותוכן</h3>
                <p class="price"><strong>10,000 ₪</strong> <span class="vat">+ מע״מ</span></p>
                <p>עד 10 עמודים · מסירה בתוך 4-5 שבועות</p>
              </a>
            </li>
            <li>
              <a href="/website-packages/#pkg-custom">
                <h3>חנות או פיתוח מותאם</h3>
                <p class="price"><span class="price-from">החל מ-</span><strong>18,000 ₪</strong> <span class="vat">+ מע״מ</span></p>
                <p>מסירה בתוך 6-8 שבועות מסיום האפיון</p>
              </a>
            </li>
          </ul>
          <a class="btn btn-link section-more" href="/website-packages/"
            >כל הפרטים על החבילות <span aria-hidden="true">&#8592;</span></a
          >
        </div>
      </section>

      <section
        class="included reveal"
        id="included"
        aria-labelledby="included-title"
      >
        <div class="container">
          <h2 class="section-title ruled" id="included-title">מה כולל פרויקט בניית אתר</h2>
          <ul class="included-list">
            <li>
              <strong>פגישת אפיון</strong>
              <p>שיחה אחת שבה מגדירים יחד מטרות, קהל ותכולה מדויקת.</p>
            </li>
            <li>
              <strong>עיצוב מותאם אישית</strong>
              <p>עיצוב מקורי שייבנה רק עבורכם וללא שימוש בתבניות מוכנות.</p>
            </li>
            <li>
              <strong>הצגת התקדמות</strong>
              <p>צפייה בהתקדמות הפרויקט בזמן אמת.</p>
            </li>
            <li>
              <strong>התאמה מלאה לנייד</strong>
              <p>רוב הלקוחות שלכם יגיעו מהטלפון, והאתר בנוי לזה קודם כול.</p>
            </li>
            <li>
              <strong>הטמעת מערכות צד שלישי</strong>
              <p>חיבור למערכות קיימות כמו CRM, ניוזלטרים, תשלום מקוון ועוד.</p>
            </li>
            <li>
              <strong>יצירת קשר</strong>
              <p>שילוב כל האפשרויות ליצירת קשר: וואטסאפ / שיחה / אימייל.</p>
            </li>
            <li>
              <strong>טיפול מלא בכל הצד הטכני</strong>
              <p>
                רכישת דומיין, אחסון האתר, הגדרות DNS, תעודת SSL, קידום בסיסי
                במנועי חיפוש וחיבור תקין של
                <a href="/google-business-profile/">פרסום העסק בגוגל</a>.
              </p>
            </li>
            <li>
              <strong>שני סבבי תיקונים</strong>
              <p>כלולים במחיר, כדי שהתוצאה תהיה בדיוק כמו שדמיינתם.</p>
            </li>
            <li>
              <strong>חודש ליווי אחרי העלייה לאוויר</strong>
              <p>תיקוני תקלות ושאלות, עלינו.</p>
            </li>
            <li>
              <strong>הדרכה ומסירה מסודרת</strong>
              <p>האתר שלכם, כולל גישה מלאה לכל החשבונות.</p>
            </li>
          </ul>
          <p class="not-included">
            <strong>לא כלול (ניתן להוסיף):</strong>
            כתיבת תוכן שיווקי וצילום
            <span class="sep" aria-hidden="true">·</span>
            עיצוב לוגו ומיתוג
            <span class="sep" aria-hidden="true">·</span>
