---
import { getImage, Picture } from "astro:assets";
import Base from "../layouts/Base.astro";
import QuoteBuilder from "../components/QuoteBuilder.astro";
import { packages } from "../data/packages";
import { allGuides } from "../data/guides";
import heroPhoto from "../assets/images/hero-piano.jpg";
import processPhoto from "../assets/images/process-gerbera.jpg";
import ctaPhoto from "../assets/images/cta-milkyway.jpg";
import projectDj from "../assets/images/project-dj.jpg";
import projectMusician from "../assets/images/project-musician.webp";
import projectApp from "../assets/images/project-app.webp";
import projectKitchen from "../assets/images/project-kitchen.webp";

// Hero and closing-CTA photos sit under navy overlays as CSS backgrounds,
// so they can't go through <Picture>: generate desktop and mobile webp
// renditions here and inject the hashed URLs with an inline <style>.
const rendition = (src: ImageMetadata, width: number, quality: number) =>
  getImage({ src, format: "webp", width, quality });

const [heroDesktop, heroMobile, ctaDesktop, ctaMobile] = await Promise.all([
  rendition(heroPhoto, 1800, 70),
  rendition(heroPhoto, 900, 68),
  rendition(ctaPhoto, 1600, 60),
  rendition(ctaPhoto, 900, 60),
]);

const bgCss = [
  `.hero{--hero-img:url("${heroDesktop.src}")}`,
  `.final-cta{--cta-img:url("${ctaDesktop.src}")}`,
  `@media (max-width:700px){`,
  `.hero{--hero-img:url("${heroMobile.src}")}`,
  `.final-cta{--cta-img:url("${ctaMobile.src}")}`,
  `}`,
].join("");

const popular = [
  { href: "/website-cost/", label: "כמה עולה אתר?" },
  { href: "/website-timeline/", label: "כמה זמן זה לוקח?" },
  { href: "/landing-page-or-website/", label: "דף נחיתה או אתר?" },
  { href: "/business-app/", label: "צריך אפליקציה?" },
  { href: "/automation-guide/", label: "מה זה אוטומציה לעסק?" },
];

const searchIndex = JSON.stringify(
  allGuides.map(({ href, title, desc }) => ({ href, title, desc })),
);

const ld0 = String.raw`{
        "@context": "https://schema.org",
        "@type": "ProfessionalService",
        "name": "One Stop Shop",
        "url": "https://onestopshop.co.il/",
        "sameAs": ["https://www.facebook.com/onestopshop.co.il"],
        "logo": "https://onestopshop.co.il/favicon-512.png",
        "image": "https://onestopshop.co.il/images/og-image.jpg",
        "description": "בניית אתרים, אפליקציות ואוטומציה לעסקים קטנים, הכול במקום אחד. מאפיון ועד השקה.",
        "areaServed": {
          "@type": "Country",
          "name": "Israel"
        },
        "inLanguage": "he",
        "knowsAbout": [
          "בניית אתרים",
          "פיתוח אפליקציות",
          "אוטומציה עסקית",
          "סוכני AI"
        ]
      }`;
---

<Base
  title={"One Stop Shop - בניית אתרים, אפליקציות ואוטומציה לעסקים"}
  description={"One Stop Shop - בניית אתרים, אפליקציות ואוטומציה לעסקים קטנים, הכול במקום אחד. מאפיון ועד השקה, כל הפרויקטים חיים באוויר."}
  path="/"
  ogType="website"
  ogTitle={"One Stop Shop - בניית אתרים, אפליקציות ואוטומציה לעסקים"}
  ogDescription={"בניית אתרים, אפליקציות ואוטומציה לעסקים - הכול במקום אחד, מאפיון ועד השקה."}
  variant="home"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={ld0} />
  </Fragment>
  <Fragment slot="head-late">
    <style is:inline set:html={bgCss}></style>
    <link
      rel="preload"
      as="image"
      href={heroMobile.src}
      media="(max-width: 700px)"
      fetchpriority="high"
    />
    <link
      rel="preload"
      as="image"
      href={heroDesktop.src}
      media="(min-width: 701px)"
      fetchpriority="high"
    />
  </Fragment>

  <header class="hero" id="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="kicker">סטודיו דיגיטלי לעסקים קטנים</p>
        <h1>כל פרויקט נבנה מאפס, בדיוק סביב מה שהעסק שלכם צריך.</h1>
        <p class="hero-sub">
          אתרים, חנויות, אפליקציות ואוטומציה - מאפיון ועד השקה, במחיר סגור
          מראש. האתר והחשבונות בבעלותכם.
        </p>
        <div class="cta-row">
          <a class="btn btn-ghost-light wa-link" href="#">
            <svg class="icon-wa" aria-hidden="true" focusable="false">
              <use href="#icon-whatsapp"></use>
            </svg>
            או פשוט כתבו לנו
          </a>
        </div>
      </div>
      <QuoteBuilder />
    </div>
  </header>

  <main id="main-content">
    <section class="live-strip" aria-labelledby="live-title">
      <div class="container">
        <h2 id="live-title">חי באוויר עכשיו:</h2>
        <ul>
          <li><a dir="ltr" href="https://line808.com/" target="_blank" rel="noopener">line808.com</a></li>
          <li><a dir="ltr" href="https://emilyjacoby.me/he" target="_blank" rel="noopener">emilyjacoby.me</a></li>
          <li><a dir="ltr" href="http://warendorf.co.il" target="_blank" rel="noopener">warendorf.co.il</a></li>
          <li>
            <a href="https://apps.apple.com/il/app/sored/id6774323194" target="_blank" rel="noopener"
              >שורד ב-App Store</a
            >
          </li>
        </ul>
      </div>
    </section>

    <section class="section" id="paths" aria-labelledby="paths-title">
      <div class="container">
        <div class="section-head">
          <h2 class="section-title" id="paths-title">שלושה מסלולים. מחיר ידוע מראש.</h2>
          <p class="section-intro">
            כל מסלול מגיע עם תכולה כתובה ולוח זמנים. מה שלא כתוב - לא יופיע
            בחשבונית.
          </p>
        </div>
        <ul class="paths">
          <li>
            <span class="path-icon" aria-hidden="true">
              <svg class="icon" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2"></rect><path d="M3 9h18"></path></svg>
            </span>
            <h3>אתר לעסק</h3>
            <p>דף נחיתה, אתר תדמית או אתר עסקי עם תוכן.</p>
            <p class="path-price">
              החל מ-<strong>{packages.landing.price}</strong> + מע״מ
            </p>
            <p class="path-time">מסירה: 5 ימים עד 5 שבועות</p>
            <a href="/website-packages/">ארבע החבילות <span aria-hidden="true">&#8592;</span></a>
          </li>
          <li class="featured">
            <span class="path-icon" aria-hidden="true">
              <svg class="icon" viewBox="0 0 24 24"><path d="M3 7h18l-2 12H5L3 7Z"></path><path d="M8 7a4 4 0 0 1 8 0"></path></svg>
            </span>
            <h3>חנות ופיתוח מותאם</h3>
            <p>חנות אונליין, אזור לקוחות, סליקה ישראלית וחיבור למערכות.</p>
            <p class="path-price">
              החל מ-<strong>{packages.custom.price}</strong> + מע״מ
            </p>
            <p class="path-time">{packages.custom.time}</p>
            <a href={`/website-packages/#${packages.custom.id}`}>מה כלול <span aria-hidden="true">&#8592;</span></a>
          </li>
          <li>
            <span class="path-icon" aria-hidden="true">
              <svg class="icon" viewBox="0 0 24 24"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8Z"></path></svg>
            </span>
            <h3>אוטומציה ו-AI</h3>
            <p>מענה ללידים, תיאום פגישות וחשבוניות שנשלחות לבד.</p>
            <p class="path-price"><strong>לפי אפיון</strong></p>
            <p class="path-time">מתחילים מתהליך אחד שחוסך הכי הרבה זמן</p>
            <a href="/automation-guide/">דוגמאות לתהליכים <span aria-hidden="true">&#8592;</span></a>
          </li>
        </ul>
      </div>
    </section>

    <section class="section section-alt" id="work" aria-labelledby="work-title">
      <div class="container">
        <h2 class="section-title" id="work-title">עבודות שחיות באוויר</h2>
        <div class="cases">
          <article class="case">
            <a class="case-media" href="https://line808.com/" target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
              <Picture
                src={projectDj}
                formats={["avif"]}
                fallbackFormat="webp"
                widths={[480, 760, 976]}
                sizes="(max-width: 900px) calc(100vw - 3rem), 560px"
                alt=""
                loading="lazy"
              />
            </a>
            <div class="case-body">
              <h3>DJ Line808 - אתר תדמית</h3>
              <dl>
                <div><dt>לפני</dt><dd>הופעות נסגרו רק דרך טלפון והמלצות.</dd></div>
                <div><dt>בנינו</dt><dd>אתר תדמית עם יומן הופעות, נגן סטים ומערכת פניות.</dd></div>
                <div class="case-result"><dt>היום</dt><dd>לקוחות סוגרים דרך האתר.</dd></div>
              </dl>
              <a href="https://line808.com/" target="_blank" rel="noopener">לאתר <span aria-hidden="true">&#8592;</span></a>
            </div>
          </article>

          <article class="case">
            <a class="case-media" href="https://emilyjacoby.me/he" target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
              <Picture
                src={projectMusician}
                formats={["avif"]}
                fallbackFormat="webp"
                widths={[480, 760, 976]}
                sizes="(max-width: 900px) calc(100vw - 3rem), 560px"
                alt=""
                loading="lazy"
              />
            </a>
            <div class="case-body">
              <h3>הפסנתרנית אמילי יעקובי - אתר אמן</h3>
              <dl>
                <div><dt>לפני</dt><dd>מוזיקה, הופעות ופניות בלי מקום אחד שמרכז אותם.</dd></div>
                <div><dt>בנינו</dt><dd>אתר מהיר עם קטעי נגינה מרסיטלים ואפשרויות לשיתופי פעולה: ליווי סולנים, רסיטלים ושיעורי נגינה.</dd></div>
              </dl>
              <a href="https://emilyjacoby.me/he" target="_blank" rel="noopener">לאתר <span aria-hidden="true">&#8592;</span></a>
            </div>
          </article>

          <article class="case">
            <a class="case-media case-media-app" href="https://apps.apple.com/il/app/sored/id6774323194" target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
              <Picture
                src={projectApp}
                formats={["avif"]}
                fallbackFormat="webp"
                widths={[240, 480]}
                sizes="200px"
                alt=""
                loading="lazy"
              />
            </a>
            <div class="case-body">
              <h3>שורד/Sored - אפליקציית מובייל</h3>
              <dl>
                <div><dt>בנינו</dt><dd>אפליקציה לתלמידים, סטודנטים וחיילים שמציגה כמה זמן נשאר לסיום השנה, הסמסטר או השירות, עד יום ההולדת והחופשה הבאה.</dd></div>
              </dl>
              <a href="https://apps.apple.com/il/app/sored/id6774323194" target="_blank" rel="noopener">ל-App Store <span aria-hidden="true">&#8592;</span></a>
            </div>
          </article>

          <article class="case">
            <a class="case-media" href="http://warendorf.co.il" target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
              <Picture
                src={projectKitchen}
                formats={["avif"]}
                fallbackFormat="webp"
                widths={[480, 760, 976]}
                sizes="(max-width: 900px) calc(100vw - 3rem), 560px"
                alt=""
                loading="lazy"
              />
            </a>
            <div class="case-body">
              <h3>ורנדורף ישראל - מטבחי יוקרה</h3>
              <dl>
                <div><dt>בנינו</dt><dd>חלון ראווה דיגיטלי ליבואן מטבחי היוקרה הגרמניים: קולקציות, אולם התצוגה ופרטי יצירת קשר.</dd></div>
              </dl>
              <a href="http://warendorf.co.il" target="_blank" rel="noopener">לאתר <span aria-hidden="true">&#8592;</span></a>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="section" id="how" aria-labelledby="how-title">
      <div class="container">
        <div class="how-head">
          <h2 class="section-title" id="how-title">בכל שלב יודעים מה מקבלים</h2>
          <Picture
            src={processPhoto}
            formats={["avif"]}
            fallbackFormat="webp"
            widths={[480, 760, 1120]}
            sizes="(max-width: 900px) calc(100vw - 3rem), 560px"
            alt=""
            loading="lazy"
            class="how-photo"
          />
        </div>
        <ol class="steps">
          <li>
            <h3>שיחת אפיון</h3>
            <p>מגדירים יחד מטרות, קהל ותכולה.</p>
            <p class="step-gets">מקבלים: תכולה כתובה</p>
          </li>
          <li>
            <h3>הצעת מחיר סגורה</h3>
            <p>כל שינוי בתכולה מקבל מחיר מעודכן לפני שממשיכים.</p>
            <p class="step-gets">מקבלים: מחיר ולוח זמנים בכתב</p>
          </li>
          <li>
            <h3>עיצוב ובנייה</h3>
            <p>עיצוב מקורי, מותאם לנייד קודם כול.</p>
            <p class="step-gets">מקבלים: צפייה בהתקדמות בזמן אמת</p>
          </li>
          <li>
            <h3>השקה וליווי</h3>
            <p>
              דומיין, אחסון, SSL ו<a href="/google-business-profile/">פרופיל עסקי בגוגל</a> -
              הכול מחובר.
            </p>
            <p class="step-gets">מקבלים: חודש ליווי וכל החשבונות</p>
          </li>
        </ol>
      </div>
    </section>

    <section class="section section-alt" id="guides" aria-labelledby="guides-title">
      <div class="container guides-grid">
        <div>
          <h2 class="section-title" id="guides-title">יש לכם שאלה? כנראה כבר ענינו עליה.</h2>
          <p class="section-intro">
            {allGuides.length} מדריכים בלי ז'רגון ובלי מכירות: מחירים, זמנים,
            אבטחה, נגישות ואוטומציה.
          </p>
        </div>
        <div class="guide-search" data-guide-search>
          <label for="guide-q">חיפוש במדריכים</label>
          <input id="guide-q" type="search" placeholder="למשל: כמה עולה חנות אונליין" autocomplete="off" />
          <p class="visually-hidden" aria-live="polite" data-count></p>
          <ul class="guide-results" data-results hidden></ul>
          <ul class="chip-row" data-popular aria-label="שאלות נפוצות">
            {
              popular.map((p) => (
                <li>
                  <a class="chip" href={p.href}>{p.label}</a>
                </li>
              ))
            }
          </ul>
          <a class="more-link" href="/guides/">לכל המדריכים <span aria-hidden="true">&#8592;</span></a>
          <script type="application/json" data-index set:html={searchIndex} />
          <script>
            import "../scripts/guide-search.js";
          </script>
        </div>
      </div>
    </section>

    <section class="final-cta" id="contact" aria-labelledby="contact-title">
      <div class="container">
        <h2 id="contact-title">שלוש שאלות, ואתם יודעים כמה זה עולה.</h2>
        <div class="cta-row">
          <a class="btn btn-primary" href="#quote">בונים הצעה <span aria-hidden="true">&#8592;</span></a>
          <a class="btn btn-whatsapp wa-link" href="#">
            <svg class="icon-wa" aria-hidden="true" focusable="false"><use href="#icon-whatsapp"></use></svg>
            כתבו לנו בוואטסאפ
          </a>
          <a class="btn btn-ghost-light email-link" href="#">
            <svg class="icon-wa" aria-hidden="true" focusable="false"><use href="#icon-mail"></use></svg>
            שלחו מייל
          </a>
        </div>
      </div>
    </section>
  </main>
</Base>
