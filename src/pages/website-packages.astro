---
import Base from "../layouts/Base.astro";
import ArticleCta from "../components/ArticleCta.astro";
import Faq from "../components/Faq.astro";
const ld0 = String.raw`{
        "@context": "https://schema.org",
        "@type": "ProfessionalService",
        "name": "One Stop Shop",
        "url": "https://onestopshop.co.il/website-packages/",
        "image": "https://onestopshop.co.il/images/og-image.jpg",
        "description": "בניית אתרים לעסקים בישראל עם תכולה, מחיר ולוח זמנים שמוגדרים מראש.",
        "areaServed": { "@type": "Country", "name": "Israel" },
        "inLanguage": "he",
        "hasOfferCatalog": {
          "@type": "OfferCatalog",
          "name": "חבילות בניית אתרים",
          "itemListElement": [
            {
              "@type": "Offer",
              "price": "1000",
              "priceCurrency": "ILS",
              "name": "דף נחיתה ממוקד",
              "itemOffered": {
                "@type": "Service",
                "name": "בניית דף נחיתה ממוקד"
              }
            },
            {
              "@type": "Offer",
              "price": "5000",
              "priceCurrency": "ILS",
              "name": "אתר תדמית ממוקד",
              "itemOffered": {
                "@type": "Service",
                "name": "בניית אתר תדמית ממוקד"
              }
            },
            {
              "@type": "Offer",
              "price": "10000",
              "priceCurrency": "ILS",
              "name": "אתר עסקי ותוכן",
              "itemOffered": {
                "@type": "Service",
                "name": "בניית אתר עסקי ותוכן"
              }
            },
            {
              "@type": "Offer",
              "price": "18000",
              "priceCurrency": "ILS",
              "name": "חנות או פיתוח מותאם",
              "itemOffered": {
                "@type": "Service",
                "name": "בניית חנות אונליין או אתר עם פיתוח מותאם"
              }
            }
          ]
        }
      }`;
const faq = [
  {
    q: "המחיר כולל אחסון ודומיין?",
    a: "לא. הדומיין והאחסון נרשמים על שמכם ומשולמים ישירות לספק, כך שהאתר נשאר בבעלותכם המלאה. אם סוכם אחרת, זה יופיע בהצעת המחיר.",
  },
  {
    q: "מי כותב את התוכן?",
    a: "אתם מעבירים טקסטים ותמונות סופיים, ואנחנו מזינים אותם לאתר. אם אין לכם תוכן מוכן, אפשר להוסיף כתיבה שיווקית כתוספת בתשלום.",
  },
  {
    q: "אפשר לשנות חבילה באמצע הדרך?",
    a: "אפשר. כל שינוי בתכולה מקבל מחיר ולוח זמנים מעודכנים בכתב לפני שממשיכים, כך שאין הפתעות בחשבונית הסופית.",
  },
  {
    q: "אתם מבטיחים מקום ראשון בגוגל?",
    a: "לא, ומי שכן מבטיח - כדאי להיזהר ממנו. החבילות כוללות תשתית SEO מסודרת כמפורט בכל חבילה, אבל אף אחד לא יכול להתחייב על דירוג או על כמות פניות.",
  },
];
---

<Base
  title={"חבילות בניית אתרים ומחירים | One Stop Shop"}
  description={"חבילות בניית אתרים לעסקים בישראל: דף נחיתה, אתר תדמית, אתר עסקי ותוכן, חנות או פיתוח מותאם. תכולה כתובה, מחיר סגור ולוח זמנים ברור מראש."}
  path="/website-packages/"
  ogType="website"
  ogTitle={"חבילות בניית אתרים ומחירים | One Stop Shop"}
  ogDescription={"דף נחיתה, אתר תדמית, אתר עסקי ותוכן או חנות - תכולה כתובה, מחיר סגור ולוח זמנים ברור מראש."}
  ogImageAlt={"One Stop Shop - בניית אתרים לעסקים"}
  variant="packages"
  waFloat={true}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={ld0} />
  </Fragment>
    <main id="main-content" class="packages-page">
      <header class="packages-hero">
        <div class="container">
          <p class="eyebrow">חבילות בניית אתרים</p>
          <h1>אתר מקצועי לעסק שלכם</h1>
          <p>
            דף נחיתה, אתר תדמית, אתר תוכן או חנות - כל חבילה כאן מגיעה עם תכולה
            כתובה, מחיר סגור ולוח זמנים ברור. בלי הבטחות מעורפלות ובלי הפתעות
            באמצע הדרך: יודעים מראש מה מקבלים, כמה משלמים ומתי עולים לאוויר.
          </p>
          <a class="btn btn-whatsapp wa-link" href="#">
            <svg class="icon-wa" aria-hidden="true" focusable="false">
              <use href="#icon-whatsapp" />
            </svg>
            ספרו לי איזה אתר אתם צריכים
          </a>
        </div>
      </header>

      <section class="packages-section" aria-labelledby="packages-title">
        <div class="container">
          <div class="section-header compact">
            <h2 id="packages-title">בוחרים נקודת התחלה</h2>
            <p class="section-intro">
              לא כל עסק צריך את אותו אתר, ולכן מתחילים בשיחת אפיון קצרה שבודקת
              איזו חבילה באמת מתאימה לכם. אם הצרכים חורגים מהתכולה, תקבלו מחיר
              ולוח זמנים מעודכנים לפני שמתחילים. רוצים להבין מה קובע את המחיר?
              כתבנו מדריך על
              <a href="/website-cost/">כמה עולה בניית אתר לעסק</a>, ואם אתם
              מתלבטים בין עמוד אחד לאתר שלם - יש גם מדריך על
              <a href="/landing-page-or-website/">ההבדל בין דף נחיתה לאתר מלא</a
              >.
            </p>
          </div>
          <div class="package-grid">
            <article class="package-card" id="pkg-landing">
              <p class="package-kicker">כשצריך עמוד אחד שעושה עבודה אחת</p>
              <h3>דף נחיתה ממוקד</h3>
              <p class="package-price">
                <strong>1,000 ₪</strong><span>+ מע״מ</span>
              </p>
              <p class="package-meta">
                עמוד אחד <span>·</span> עד 4 אזורי תוכן <span>·</span> מסירה
                בתוך 5 ימים <span>·</span> סבב תיקונים אחד
              </p>
              <h4>מה כלול</h4>
              <ul class="check-list">
                <li>עמוד אחד על בסיס תבנית מעוצבת קיימת</li>
                <li>
                  עד 4 אזורי תוכן: פתיח, ההצעה שלכם, יתרונות וקריאה לפעולה
                </li>
                <li>התאמה מלאה לנייד ולמחשב</li>
                <li>כפתור וואטסאפ וקישורים לטלפון ולמייל</li>
                <li>הזנת הטקסטים והתמונות שתעבירו בקובץ מסודר</li>
                <li>כותרת ותיאור בסיסיים למנועי החיפוש</li>
                <li>סבב תיקונים מרוכז אחד</li>
              </ul>
              <details class="excluded-details">
                <summary>מה לא כלול</summary>
                <p class="excluded">
                כתיבת תוכן, עיצוב לוגו, צילום, תרגום, רכישת תמונות, דומיין,
                אחסון ורישיונות. אין מערכת ניהול תוכן לעריכה עצמית, בלוג, עמודים
                נוספים, טפסים מותאמים, סליקה, חיבור למערכות חיצוניות, אוטומציות
                או פיתוח ייעודי. אזור תוכן נוסף או שינוי מבנה מתומחרים בנפרד.
              </p>
              </details>
              <a class="btn btn-link wa-link" href="#"
                >בואו נבדוק אם דף נחיתה מספיק לכם</a
              >
            </article>
            <article class="package-card" id="pkg-brochure">
              <p class="package-kicker">לעסק קטן או לנותני שירות</p>
              <h3>אתר תדמית ממוקד</h3>
              <p class="package-price">
                <strong>5,000 ₪</strong><span>+ מע״מ</span>
              </p>
              <p class="package-meta">
                עד 5 עמודים <span>·</span> מסירה בתוך שבועיים <span>·</span> 2
                סבבי תיקונים
              </p>
              <h4>מה כלול</h4>
              <ul class="check-list">
                <li>שיחת אפיון ושאלון תוכן מסודר</li>
                <li>עיצוב על בסיס השפה הגרפית שלכם, עם תבנית שמותאמת לעסק</li>
                <li>בנייה בוורדפרס או במערכת אחרת שנסכם עליה מראש</li>
                <li>טופס יצירת קשר, כפתור וואטסאפ, טלפון ומייל</li>
                <li>תשתית SEO טכנית: מפת אתר וחיבור ל-Search Console</li>
                <li>חיבור Google Analytics בחשבון שלכם</li>
                <li>הזנת התוכן שתעבירו, עד 5 עמודים</li>
                <li>הדרכת מסירה של עד 45 דקות ו-14 ימי אחריות</li>
              </ul>
              <details class="excluded-details">
                <summary>מה לא כלול</summary>
                <p class="excluded">
                כתיבת תוכן, לוגו, צילום, תרגום, רכישת תמונות, דומיין, אחסון
                ורישיונות. אין חנות, סליקה, אזור אישי, מערכת הזמנות, CRM,
                אוטומציות או פיתוח ייעודי. לא כולל קידום שוטף, התחייבות לדירוג
                או אישור נגישות משפטי.
              </p>
              </details>
              <a class="btn btn-link wa-link" href="#"
                >בואו נדבר על אתר תדמית</a
              >
            </article>
            <article class="package-card featured" id="pkg-business">
              <p class="package-badge">מומלץ</p>
              <p class="package-kicker">לעסק עם כמה שירותים ותוכן מקצועי</p>
              <h3>אתר עסקי ותוכן</h3>
              <p class="package-price">
                <strong>10,000 ₪</strong><span>+ מע״מ</span>
              </p>
              <p class="package-meta">
                עד 10 עמודים <span>·</span> מסירה בתוך 4-5 שבועות
                <span>·</span> 3 סבבי תיקונים
              </p>
              <h4>מה כלול</h4>
              <ul class="check-list">
                <li>אפיון מעמיק: מבנה האתר, קהלי היעד והפעולות החשובות בו</li>
                <li>עד 7 עמודים קבועים, תשתית בלוג והזנת עד 3 מאמרים מוכנים</li>
                <li>עד 3 תבניות עמוד שונות</li>
                <li>כל מה שכלול בחבילת התדמית</li>
                <li>בלוג עם קטגוריות ותגיות</li>
                <li>עד 2 טפסים, עד 8 שדות בכל אחד</li>
                <li>
                  מחקר מילות מפתח לעד 10 ביטויים, מפת כותרות וסימון schema בסיסי
                </li>
                <li>אופטימיזציית מהירות בסיסית</li>
                <li>הדרכת מסירה של עד שעה ו-30 ימי אחריות</li>
              </ul>
              <details class="excluded-details">
                <summary>מה לא כלול</summary>
                <p class="excluded">
                כתיבת תוכן מאפס, קידום מתמשך, בניית קישורים והתחייבות לדירוג.
                אין חנות, סליקה, אזור אישי, חיפוש מתקדם, חיבורי API, CRM או
                אוטומציות. מיתוג, צילום, תרגום, רישיונות, דומיין ואחסון נרכשים
                בנפרד, וכך גם אישור נגישות משפטי.
              </p>
              </details>
              <a class="btn btn-link wa-link" href="#"
                >בואו נתכנן את האתר העסקי</a
              >
            </article>
            <article class="package-card" id="pkg-custom">
              <p class="package-kicker">
                למי שמוכר אונליין או צריך פיתוח ייעודי
              </p>
              <h3>חנות או פיתוח מותאם</h3>
              <p class="package-price">
                <strong>החל מ-18,000 ₪</strong><span>+ מע״מ</span>
              </p>
              <p class="package-meta">
                מסירה בתוך 6-8 שבועות מסיום האפיון <span>·</span> 3 סבבי תיקונים
              </p>
              <h4>מה כלול במחיר הפתיחה</h4>
              <ul class="check-list">
                <li>פגישת אפיון של עד שעתיים ומסמך תכולה מסודר</li>
                <li>עד 8 עמודי תוכן</li>
                <li>חנות עם עד 25 מוצרים: עמודי קטלוג ומוצר, עגלה וקופה</li>
                <li>קופונים, תעריף משלוח אחיד וחיבור לספק סליקה ישראלי אחד</li>
                <li>לחלופין: מודול מותאם אישית אחד, עד 24 שעות פיתוח</li>
                <li>בדיקת תהליך הרכישה מקצה לקצה, במחשב ובנייד</li>
                <li>הדרכת מסירה של עד שעה וחצי ו-45 ימי אחריות</li>
              </ul>
              <details class="excluded-details">
                <summary>מה לא כלול</summary>
                <p class="excluded">
                עמלות סליקה, חשבוניות, משלוחים, תוספים בתשלום, אחסון ורישיונות.
                אין חיבור ERP, סנכרון מלאי, מועדון לקוחות, מרקטפלייס, תמחור לפי
                לקוח, ריבוי מחסנים, אפליקציה או אוטומציות, ולא יותר ממודול מותאם
                אחד. מעל 25 מוצרים או פיתוח שאינו במסמך התכולה מתומחרים בנפרד.
                המחיר הסופי נסגר רק אחרי האפיון.
              </p>
              </details>
              <a class="btn btn-link wa-link" href="#">מתחילים בשיחת אפיון</a>
            </article>
          </div>
          <p class="timeline-note">
            לוח הזמנים נספר מהרגע שהתקבלו המקדמה, הגישות וכל התוכן הסופי - עיכוב
            בחומרים דוחה את המסירה בהתאם. רוצים להבין ממה מורכב לוח הזמנים?
            כתבנו על
            <a href="/website-timeline/">כמה זמן באמת לוקח לבנות אתר</a>.
          </p>
        </div>
      </section>

      <section class="retainers" aria-labelledby="retainers-title">
        <div class="container">
          <div class="section-header compact">
            <h2 id="retainers-title">ליווי חודשי</h2>
            <p class="section-intro">
              האתר לא נגמר ביום ההשקה - צריך לעדכן, לגבות ולשפר אותו גם אחרי.
              למה זה חשוב? הסברנו במדריך על
              <a href="/website-maintenance/">תחזוקת אתרים</a>. שעות שלא נוצלו
              בחודש מסוים אינן נצברות לחודש הבא.
            </p>
          </div>
          <div class="retainer-grid">
            <article>
              <h3>תחזוקה Essential</h3>
              <p class="mini-price">390 ₪ + מע״מ לחודש</p>
              <p>
                עדכוני מערכת ותוספים, גיבוי, ניטור ובדיקת אבטחה בסיסית פעם
                בחודש, עד חצי שעה של שינויי תוכן ומענה בתוך שני ימי עבודה. אחסון
                ורישיונות משולמים בנפרד.
              </p>
            </article>
            <article>
              <h3>תחזוקה Business</h3>
              <p class="mini-price">790 ₪ + מע״מ לחודש</p>
              <p>
                כל מה שב-Essential, ובנוסף עד שעתיים של שינויים קטנים, בדיקת
                טפסים חודשית ודוח מצב קצר, עם מענה בתוך יום עבודה. לא כולל פיתוח
                פיצ'רים, עמודים חדשים, כתיבת תוכן או טיפול בתקלות של ספקים
                חיצוניים.
              </p>
            </article>
            <article>
              <h3>תוכן ו-SEO בסיסי</h3>
              <p class="mini-price">1,490 ₪ + מע״מ לחודש</p>
              <p>
                בהתחייבות לשלושה חודשים: מעקב Search Console ו-GA4 אחרי עד 15
                ביטויים, שיפור עמוד קיים אחד, מאמר חדש אחד עד 800 מילים ושעת
                שיפורים טכניים בכל חודש. בלי בניית קישורים ובלי הבטחות דירוג.
              </p>
            </article>
          </div>
        </div>
      </section>

      <section class="addons" aria-labelledby="addons-title">
        <div class="container">
          <div class="section-header compact">
            <h2 id="addons-title">תוספות במחיר סגור</h2>
          </div>
          <div class="table-wrap" tabindex="0" aria-label="טבלת מחירי תוספות">
            <table>
              <thead>
                <tr>
                  <th>תוספת</th>
                  <th>מחיר</th>
                  <th>מה זה כולל</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>עמוד נוסף על תבנית קיימת</td>
                  <td>550 ₪</td>
                  <td>עד 800 מילים, עם תוכן ותמונות מוכנים מכם</td>
                </tr>
                <tr>
                  <td>תבנית עמוד חדשה</td>
                  <td>1,400 ₪</td>
                  <td>עיצוב ופיתוח של מבנה עמוד אחד</td>
                </tr>
                <tr>
                  <td>שפה נוספת</td>
                  <td>35% ממחיר החבילה, מינימום 2,500 ₪</td>
                  <td>אותו מבנה אתר; התרגום מסופק על ידכם; רישיון בנפרד</td>
                </tr>
                <tr>
                  <td>הצהרת נגישות והטמעה בסיסית</td>
                  <td>750 ₪</td>
                  <td>שיפורי נגישות בסיסיים והצהרה; אינו אישור משפטי</td>
                </tr>
                <tr>
                  <td>בדיקה והתאמה לתקן נגישות</td>
                  <td>החל מ-3,500 ₪</td>
                  <td>מחיר סופי אחרי מיפוי; בדיקת מומחה חיצוני בנפרד</td>
                </tr>
                <tr>
                  <td>לוגו בסיסי</td>
                  <td>1,800 ₪</td>
