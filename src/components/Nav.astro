---
// variant "home": index page - anchor links into the one-pager.
// Everywhere else the section links point back into "/".
// The quote builder CTA sits beside the links on desktop.
// The current page is derived from the URL, so no page has to declare it.
interface Props {
  variant: "home" | "article" | "packages";
}
const { variant } = Astro.props;

const home = variant === "home";
const here = Astro.url.pathname.replace(/\/?$/, "/");
const links = [
  { href: home ? "#how" : "/#how", label: "איך זה עובד" },
  { href: home ? "#work" : "/#work", label: "עבודות" },
  { href: "/website-packages/", label: "חבילות ומחירים" },
  { href: "/guides/", label: "מדריכים" },
].map((l) => ({ ...l, current: l.href === here }));
---

<nav class="topnav" aria-label="ניווט ראשי">
  <div class="container nav-inner">
    <a class="brand" href={home ? "#hero" : "/"} dir="ltr"
      >One Stop Shop<span class="accent-dot" aria-hidden="true">.</span></a
    >
    <ul class="nav-links">
      {
        links.map(({ href, label, current }) => (
          <li>
            <a href={href} aria-current={current ? "page" : undefined}>
              {label}
            </a>
          </li>
        ))
      }
    </ul>
    <a class="btn btn-primary nav-cta" href={home ? "#quote" : "/#quote"}
      >בונים הצעה <span aria-hidden="true">&#8592;</span></a
    >
    <details class="nav-menu">
      <summary>
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
        <span class="visually-hidden">תפריט</span>
      </summary>
      <ul>
        {
          links.map(({ href, label, current }) => (
            <li>
              <a href={href} aria-current={current ? "page" : undefined}>
                {label}
              </a>
            </li>
          ))
        }
        <li>
          <a class="wa-link" href="#">כתבו לנו בוואטסאפ</a>
        </li>
      </ul>
    </details>
  </div>
</nav>
