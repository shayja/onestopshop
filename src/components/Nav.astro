---
// variant "home": index page - anchor links into the one-pager.
// variant "packages": packages page - marks itself with aria-current.
// variant "article": every other inner page.
interface Props {
  variant: "home" | "article" | "packages";
}
const { variant } = Astro.props;
---

<nav class="topnav" aria-label="ניווט ראשי">
  <div class="container nav-inner">
    <a class="brand" href={variant === "home" ? "#hero" : "/"} dir="ltr"
      >One Stop Shop<span class="accent-dot" aria-hidden="true">.</span></a
    >
    <ul class="nav-links">
      {
        variant === "home" ? (
          <>
            <li><a href="#hero">ראשי</a></li>
            <li><a href="#projects">פרויקטים</a></li>
            <li><a href="/website-packages/">חבילות</a></li>
            <li><a href="/guides/">מדריכים</a></li>
            <li><a href="#contact">יצירת קשר</a></li>
          </>
        ) : (
          <>
            <li><a href="/">ראשי</a></li>
            <li><a href="/#projects">פרויקטים</a></li>
            <li>
              <a
                href="/website-packages/"
                aria-current={variant === "packages" ? "page" : undefined}
                >חבילות</a
              >
            </li>
            <li><a href="/guides/">מדריכים</a></li>
            <li><a href="/#contact">יצירת קשר</a></li>
          </>
        )
      }
    </ul>
  </div>
</nav>
