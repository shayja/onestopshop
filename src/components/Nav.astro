---
// variant "home": index page - anchor links into the one-pager.
// variant "packages": packages page - marks itself with aria-current.
// variant "article": every other inner page.
interface Props {
  variant: "home" | "article" | "packages";
}
const { variant } = Astro.props;

// On the one-pager, section links are bare anchors; everywhere else they
// point back into "/". Only the first two hrefs differ between variants.
const home = variant === "home";
const links = [
  { href: home ? "#hero" : "/", label: "ראשי" },
  { href: home ? "#projects" : "/#projects", label: "פרויקטים" },
  { href: "/website-packages/", label: "חבילות", current: variant === "packages" },
  { href: "/guides/", label: "מדריכים" },
  { href: home ? "#contact" : "/#contact", label: "יצירת קשר" },
];
---

<nav class="topnav" aria-label="ניווט ראשי">
  <div class="container nav-inner">
    <a class="brand" href={home ? "#hero" : "/"} dir="ltr"
      >One Stop Shop<span class="accent-dot" aria-hidden="true">.</span></a
    >
    <ul class="nav-links">
      {
        links.map(({ href, label, current }) => (
          <li>
            <a href={href} aria-current={current ? "page" : undefined}>
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>
