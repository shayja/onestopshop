---
// FAQ accordion: the {q, a} items are the single source for both the
// visible details/summary markup and the FAQPage JSON-LD, so they can never drift.
// Answers may contain inline HTML (links); the schema gets a plain-text copy.
interface FaqItem {
  q: string;
  a: string;
}
interface Props {
  title?: string;
  headingId?: string;
  items: FaqItem[];
}
const { title = "שאלות נפוצות", headingId, items } = Astro.props;

const plain = (html: string) =>
  html
    .replace(/<[^>]+>/g, "")
    .replace(/\s+/g, " ")
    .trim();

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  inLanguage: "he",
  mainEntity: items.map(({ q, a }) => ({
    "@type": "Question",
    name: q,
    acceptedAnswer: { "@type": "Answer", text: plain(a) },
  })),
});
---

<h2 id={headingId}>{title}</h2>
<div class="faq-list">
  {
    items.map(({ q, a }) => (
      <details class="faq-item">
        <summary>{q}</summary>
        <p set:html={a} />
      </details>
    ))
  }
</div>
<script type="application/ld+json" set:html={schema} />
