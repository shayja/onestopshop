---
import "../styles.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import ActionBar from "../components/ActionBar.astro";
import { enhanceArticle } from "../lib/article";

interface Props {
  title: string;
  description: string;
  path: string; // canonical path, e.g. "/website-cost/"
  ogType?: "website" | "article";
  ogTitle: string; // also used for twitter:title
  ogDescription: string; // also used for twitter:description
  ogImageAlt?: string;
  variant?: "home" | "article" | "packages"; // picks nav + footer flavor
  datePublished?: string; // presence turns on the Article JSON-LD
  dateModified?: string;
}

const {
  title,
  description,
  path,
  ogType = "article",
  ogTitle,
  ogDescription,
  ogImageAlt = "One Stop Shop - בניית אתרים, אפליקציות ואוטומציה לעסקים",
  variant = "article",
  datePublished,
  dateModified,
} = Astro.props;

const canonical = `https://onestopshop.co.il${path}`;
const ogImage = "https://onestopshop.co.il/images/og-image.jpg";

// Article schema is built here from the same strings the meta tags use,
// so headline/description can't drift from the page's title/description.
const articleSchema = datePublished
  ? JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      headline: ogTitle,
      description,
      inLanguage: "he",
      mainEntityOfPage: canonical,
      image: ogImage,
      datePublished,
      dateModified: dateModified ?? datePublished,
      author: {
        "@type": "Organization",
        name: "One Stop Shop",
        url: "https://onestopshop.co.il/",
      },
      publisher: {
        "@type": "Organization",
        name: "One Stop Shop",
        logo: {
          "@type": "ImageObject",
          url: "https://onestopshop.co.il/favicon-512.png",
        },
      },
    })
  : null;

// Guide pages (the ones with a datePublished) get the meta line, heading ids
// and table of contents injected at build time - see src/lib/article.ts.
const content = await Astro.slots.render("default");
const body = datePublished
  ? enhanceArticle(content, { path, datePublished, dateModified })
  : content;
---

<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="he_IL" />
    <meta property="og:site_name" content="One Stop Shop" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />

    {articleSchema && <script type="application/ld+json" set:html={articleSchema} />}

    <slot name="head" />

    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-192.png" sizes="192x192" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f3f5f8" />

    <slot name="head-late" />

    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/heebo-var-hebrew.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/heebo-var-latin.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/rubik-var-hebrew.woff2"
      crossorigin
    />

    <script is:inline>
      document.documentElement.classList.add("js");
    </script>

    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-TM6KP45DQF");
      window.addEventListener("load", function () {
        setTimeout(function () {
          var s = document.createElement("script");
          s.async = true;
          s.src = "https://www.googletagmanager.com/gtag/js?id=G-TM6KP45DQF";
          document.head.appendChild(s);
        }, 1500);
      });
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">דלג לתוכן המרכזי</a>
    <svg width="0" height="0" style="position: absolute" aria-hidden="true">
      <symbol id="icon-whatsapp" viewBox="0 0 24 24">
        <path
          fill="currentColor"
          d="M12 2a10 10 0 0 0-8.65 15L2 22l5.15-1.33A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.06.79.82-2.98-.2-.31A8.2 8.2 0 1 1 12 20.2Zm4.5-6.13c-.25-.12-1.46-.72-1.68-.8-.23-.09-.39-.13-.56.12-.16.25-.64.8-.78.97-.14.16-.29.18-.53.06-.25-.12-1.04-.38-1.98-1.22-.73-.65-1.22-1.45-1.37-1.7-.14-.24-.01-.38.11-.5.11-.11.25-.29.37-.43.12-.14.16-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.43h-.48c-.16 0-.43.06-.66.31-.22.25-.86.84-.86 2.05 0 1.21.88 2.38 1 2.55.13.16 1.74 2.65 4.2 3.72.59.25 1.05.4 1.4.52.59.19 1.13.16 1.56.1.47-.07 1.46-.6 1.66-1.17.21-.58.21-1.07.15-1.17-.06-.1-.23-.17-.47-.29Z"
        />
      </symbol>
      <symbol id="icon-mail" viewBox="0 0 24 24">
        <path
          fill="currentColor"
          d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Zm0 4-8 5-8-5V6l8 5 8-5v2Z"
        />
      </symbol>
      <symbol id="icon-facebook" viewBox="0 0 24 24">
        <path
          fill="currentColor"
          d="M14 13.5h2.5l1-4H14v-2c0-1.03 0-2 2-2h1.5V2.14A28 28 0 0 0 14.64 2C11.93 2 10 3.66 10 6.7v2.8H7v4h3V22h4v-8.5Z"
        />
      </symbol>
    </svg>
    <Nav variant={variant} />
    {datePublished && <div class="read-progress" aria-hidden="true"><span></span></div>}

    <Fragment set:html={body} />

    <Footer variant={variant} />

    <ActionBar
      variant={variant === "home" ? "home" : datePublished ? "article" : "default"}
    />

    <script>
      import "../scripts/site.js";
    </script>
  </body>
</html>
